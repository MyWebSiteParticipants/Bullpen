# Copy this file to .env.local (which is git-ignored) and fill in your keys.
#
# Get them at https://app.alpaca.markets  ->  Paper Trading  ->  API Keys.
# These are read ONLY by the Vite dev-server proxy (see vite.config.ts) and
# are never bundled into the browser app, because they have no VITE_ prefix.


# "true" = paper-api.alpaca.markets (default). Set to "false" ONLY when you
# have deliberately decided to trade real money with live keys.
ALPACA_PAPER=true

# Optional: fundamentals (market cap, P/E, EPS, dividend yield, beta,
# industry, next earnings date) on the symbol detail panel. Alpaca does not
# provide these. Get a free key at https://finnhub.io (60 calls/min).
# Leave blank and the panel simply hides that section.
FINNHUB_KEY=
